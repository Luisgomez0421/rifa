# ==========================================
# CONFIGURACIÓN DE SUPABASE - MI GRAN RIFA
# ==========================================
# Obtén estos valores en tu panel de Supabase:
# Project Settings -> API
#
# URL del proyecto (Ejemplo: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (anon public key)
# NOTA: Esta clave es segura para el frontend porque está protegida por Row Level Security (RLS).
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Precio por número en pesos/moneda local (opcional para visualización)
VITE_TICKET_PRICE=20000

# Nombre del organizador / rifa
VITE_RAFFLE_NAME=Mi Gran Rifa

# Contacto de soporte / WhatsApp (para comprobantes de pago)
VITE_ADMIN_WHATSAPP=+573001234567
